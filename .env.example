# Copy this file to .env and adjust it before deployment.
TZ=Etc/UTC
NPMPLUS_DATA_DIR=/opt/npmplus

# All auxiliary services start with the default Compose stack.

# CrowdSec requires access logs and a bouncer key configured after first start.
LOGROTATE=true
CROWDSEC_CONFIG_DIR=/opt/crowdsec/conf
CROWDSEC_DATA_DIR=/opt/crowdsec/data
CROWDSEC_LAPI_PORT=8080
CROWDSEC_APPSEC_PORT=7422

# Anubis runs in subrequest mode on host loopback.
AUTH_REQUEST_ANUBIS_UPSTREAM=http://127.0.0.1:8923
ANUBIS_PORT=8923

# Enable GOA and/or the GeoIP2 module to consume the downloaded databases.
GOA=false
NGINX_LOAD_GEOIP2_MODULE=false
MAXMIND_ACCOUNT_ID_SECRET_FILE=./secrets/maxmind_account_id
MAXMIND_LICENSE_KEY_SECRET_FILE=./secrets/maxmind_license_key
GEOIPUPDATE_FREQUENCY=24

# Caddy owns public port 80, so NPMplus HTTP is disabled.
DISABLE_HTTP=true
CADDY_HTTP_PORT=80
